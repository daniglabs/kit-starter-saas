# Core
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="saas-kit-starter"

# Auth
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Public app info
APP_PUBLIC_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_NAME="SaaS Kit Starter"
NEXT_PUBLIC_APP_NAME="SaaS Kit Starter"

# Mail (SMTP)
MAILTRAP_HOST="sandbox.smtp.mailtrap.io"
MAILTRAP_PORT="2525"
MAILTRAP_USER=""
MAILTRAP_PASS=""
MAIL_FROM="SaaS Kit <no-reply@saaskit.local>"
MAIL_BRAND_COLOR="#2563eb"

# Billing provider selector
# noop | stripe | paypal | ...
BILLING_PROVIDER="noop"

# Seed endpoint protection for non-development environments
# Header required: x-seed-secret: <SEED_SECRET>
SEED_SECRET=""
